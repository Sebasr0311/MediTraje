{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/DECISIONES.md", "docs/PROGRESO.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "mvn *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "oracle-sqlcl": {
      "type": "local",
      "command": ["sql", "-mcp"],
      "enabled": false
    }
  }
}
