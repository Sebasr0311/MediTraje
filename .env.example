# ==============================================================================
# MediTriaje 2.0 — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# IMPORTANTE:
# - Copia este archivo como .env para desarrollo local si utilizas herramientas que lo soporten.
# - NUNCA agregues valores reales ni subas tu archivo .env al repositorio Git.
# - Las credenciales y el wallet deben permanecer fuera del repositorio (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Oracle ATP (Autonomous Transaction Processing)
# ------------------------------------------------------------------------------
# URL JDBC Thin con TNS_ADMIN apuntando al directorio donde descargaste el Wallet
# Ejemplo Linux/macOS: jdbc:oracle:thin:@meditriaje_tp?TNS_ADMIN=/Users/juan/oracle/wallet
# Ejemplo Windows:     jdbc:oracle:thin:@meditriaje_tp?TNS_ADMIN=C:/oracle/wallet
DB_URL=jdbc:oracle:thin:@<alias_db>_tp?TNS_ADMIN=/ruta/al/wallet

# Usuario de runtime para la aplicación (mínimos privilegios, ADR-012)
DB_USER=MEDITRIAJE_APP
DB_PASSWORD=tu_password_app_aqui

# Usuario propietario del esquema para migraciones Flyway (DDL / admin esquema, ADR-012)
FLYWAY_USER=MEDITRIAJE_OWNER
FLYWAY_PASSWORD=tu_password_owner_aqui

# ------------------------------------------------------------------------------
# 2. Seguridad y Tokens JWT (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Clave secreta criptográfica de al menos 256 bits (32 bytes en Base64 o string largo)
JWT_SECRET=reemplazar_con_un_secreto_seguro_de_al_menos_256_bits_en_base64_o_hex

# ------------------------------------------------------------------------------
# 3. Servidor Web y CORS
# ------------------------------------------------------------------------------
# Puerto de escucha de la aplicación Spring Boot
SERVER_PORT=8080

# Orígenes permitidos para peticiones CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500
