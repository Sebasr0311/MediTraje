### ----------------------------------------------------------------------------
### 3. Flujo Previo Asistencial: Disponibilidad, Reserva, Atención y Emisión de Receta
### ----------------------------------------------------------------------------

### 3.1 Consulta de Catálogo de Medicamentos Activos
# @name listarMedicamentos
GET {{baseUrl}}/catalogs/medications?page=0&size=5
Accept: application/json

@medAmoxiId = {{listarMedicamentos.response.body.content[0].publicId}}
@medParacId = {{listarMedicamentos.response.body.content[1].publicId}}

### 3.2 Login con Paciente 1 para agendar cita
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "email": "carlos.perez@example.com",
  "password": "PasswordSegura123*"
}

### 3.3 Consulta de Disponibilidad de Citas
# @name consultarDisponibilidad
GET {{baseUrl}}/availability?modalidad=PRESENCIAL&page=0&size=5
Accept: application/json

@slotPublicId = {{consultarDisponibilidad.response.body.content[0].slotPublicId}}

### 3.4 Reserva de Cita Médica
# @name reservarCita
POST {{baseUrl}}/appointments
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "slotPublicId": "{{slotPublicId}}"
}

@citaPublicId = {{reservarCita.response.body.publicId}}

### 3.5 Login con Médico 1 para atender la cita
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "email": "camilo.torres@meditriaje.com",
  "password": "PasswordSegura123*"
}

### 3.6 Iniciar Atención Médica
# @name iniciarAtencion
POST {{baseUrl}}/attentions
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "citaPublicId": "{{citaPublicId}}"
}

@atencionPublicId = {{iniciarAtencion.response.body.publicId}}

### 3.7 Registrar Signos Vitales
POST {{baseUrl}}/attentions/{{atencionPublicId}}/vital-signs
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "presionSistolica": 120,
  "presionDiastolica": 80,
  "frecuenciaCardiaca": 75,
  "frecuenciaRespiratoria": 16,
  "temperatura": 36.6,
  "saturacionOxigeno": 98
}

### 3.8 Cerrar Atención Médica (Diagnóstico CIE-10)
# @name cerrarAtencion
PATCH {{baseUrl}}/attentions/{{atencionPublicId}}/close
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "motivoConsulta": "Faringoamigdalitis aguda y cefalea moderada",
  "enfermedadActual": "Paciente refiere cuadro de 3 dias de evolucion caracterizado por odinofagia y alzas termicas",
  "diagnosticoCie10": "J029",
  "diagnosticoDescripcion": "Faringitis aguda, no especificada",
  "planManejo": "Tratamiento antibiotico oral y antipiretico segun prescripcion medica",
  "evolucion": "Paciente orientado, hemodinamicamente estable con signos vitales dentro de limites normales"
}

### 3.9 Emitir Receta Médica con 2 Medicamentos (Vigencia 30 días)
### -> DEBE RETORNAR 201 Created con cabecera Location
# @name emitirReceta
POST {{baseUrl}}/prescriptions
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "atencionPublicId": "{{atencionPublicId}}",
  "vigenciaDias": 30,
  "detalles": [
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "dosis": "500 mg",
      "frecuencia": "Cada 8 horas",
      "duracionDias": 7,
      "cantidad": 21,
      "indicaciones": "Tomar con abundante agua despues de las comidas."
    },
    {
      "medicamentoPublicId": "{{medParacId}}",
      "dosis": "500 mg",
      "frecuencia": "Cada 6 horas en caso de dolor o fiebre",
      "duracionDias": 5,
      "cantidad": 10,
      "indicaciones": "No exceder 4 gramos diarios."
    }
  ]
}

@recetaPublicId = {{emitirReceta.response.body.publicId}}

### ----------------------------------------------------------------------------
### 4. Ventanilla de Farmacia: Búsqueda y Consulta (ROLE_FARMACEUTICO)
### ----------------------------------------------------------------------------

### 4.1 Login con Farmacéutico
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "email": "farmacia@meditriaje.com",
  "password": "Admin12345*"
}

### 4.2 Listar Sedes Activas para Dispensación
# @name listarSedesFarmacia
GET {{baseUrl}}/pharmacy/sites
Accept: application/json

@sedePublicId = {{listarSedesFarmacia.response.body[0].publicId}}

### 4.3 Búsqueda de Recetas Médicas por Documento del Paciente
### -> DEBE RETORNAR 200 OK con la receta encontrada y su código de reclamación
# @name buscarPorDocumento
GET {{baseUrl}}/pharmacy/prescriptions?query=1098765432&page=0&size=10
Accept: application/json

@codigoReclamacion = {{buscarPorDocumento.response.body.content[0].codigoReclamacion}}

### 4.4 Búsqueda de Recetas Médicas por Código de Reclamación
### -> DEBE RETORNAR 200 OK con la receta exacta
# @name buscarPorCodigoReclamacion
GET {{baseUrl}}/pharmacy/prescriptions?query={{codigoReclamacion}}
Accept: application/json

### 4.5 Consulta Detallada de la Receta con Saldos Disponibles
### -> DEBE RETORNAR 200 OK con estado PENDIENTE, saldos y cero entregas previas
# @name consultarRecetaFarmacia
GET {{baseUrl}}/pharmacy/prescriptions/{{recetaPublicId}}
Accept: application/json

### ----------------------------------------------------------------------------
### 5. Dispensación Parcial de Medicamentos (F2.4, ADR-016)
### ----------------------------------------------------------------------------

### 5.1 Registrar Entrega Parcial: 10 de Amoxicilina (de 21) y 5 de Paracetamol (de 10)
### -> DEBE RETORNAR 201 Created con cabecera Location y detalle de lote INVIMA
# @name dispensacionParcial
POST {{baseUrl}}/pharmacy/dispensations
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "recetaPublicId": "{{recetaPublicId}}",
  "sedePublicId": "{{sedePublicId}}",
  "observaciones": "Primera entrega parcial. Faltan 11 amoxicilina y 5 paracetamol.",
  "detalles": [
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "cantidadEntregada": 10,
      "lote": "INV-AMX-2026-01",
      "fechaVencimientoLote": "2027-12-31"
    },
    {
      "medicamentoPublicId": "{{medParacId}}",
      "cantidadEntregada": 5,
      "lote": "INV-PCT-2026-03",
      "fechaVencimientoLote": "2028-06-30"
    }
  ]
}

@dispensacion1Id = {{dispensacionParcial.response.body.publicId}}

### 5.2 Consultar Comprobante de la Primera Dispensación
# @name consultarComprobante1
GET {{baseUrl}}/pharmacy/dispensations/{{dispensacion1Id}}
Accept: application/json

### 5.3 Verificar Saldos Actualizados en la Receta
### -> DEBE RETORNAR 200 OK con estado DISPENSADA_PARCIAL, Amoxi saldo=11, Parac saldo=5
# @name verificarSaldosParciales
GET {{baseUrl}}/pharmacy/prescriptions/{{recetaPublicId}}
Accept: application/json

### ----------------------------------------------------------------------------
### 6. Control Matemático de Saldos y Validaciones Sanitarias (400 Bad Request)
### ----------------------------------------------------------------------------

### 6.1 Intento de Sobredispensación (Solicitar 15 de Amoxicilina cuando el saldo es 11)
### -> DEBE RETORNAR 400 Bad Request con código DATOS_INVALIDOS
POST {{baseUrl}}/pharmacy/dispensations
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "recetaPublicId": "{{recetaPublicId}}",
  "sedePublicId": "{{sedePublicId}}",
  "detalles": [
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "cantidadEntregada": 15,
      "lote": "LOTE-SOBRE-01"
    }
  ]
}

### 6.2 Intento de Dispensación sin Detalles de Medicamentos
### -> DEBE RETORNAR 400 Bad Request con código VALIDACION_FALLIDA
POST {{baseUrl}}/pharmacy/dispensations
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "recetaPublicId": "{{recetaPublicId}}",
  "sedePublicId": "{{sedePublicId}}",
  "detalles": []
}

### 6.3 Intento de Dispensación con Medicamento Duplicado en la Misma Solicitud
### -> DEBE RETORNAR 400 Bad Request con código DATOS_INVALIDOS
POST {{baseUrl}}/pharmacy/dispensations
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "recetaPublicId": "{{recetaPublicId}}",
  "sedePublicId": "{{sedePublicId}}",
  "detalles": [
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "cantidadEntregada": 2,
      "lote": "LOTE-1"
    },
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "cantidadEntregada": 3,
      "lote": "LOTE-2"
    }
  ]
}

### 6.4 Intento de Dispensación con Sede Inexistente
### -> DEBE RETORNAR 404 Not Found con código RECURSO_NO_ENCONTRADO
POST {{baseUrl}}/pharmacy/dispensations
Content-Type: application/json
Accept: application/json
{{csrfHeader}}: {{csrfValue}}

{
  "recetaPublicId": "{{recetaPublicId}}",
  "sedePublicId": "00000000-0000-0000-0000-000000000000",
  "detalles": [
    {
      "medicamentoPublicId": "{{medAmoxiId}}",
      "cantidadEntregada": 1
    }
  ]
}

